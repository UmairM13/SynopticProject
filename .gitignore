# Ignore environment variables
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.ci

# Ignore compiled Python files
__pycache__/
*.pyc
*.pyo

# Ignore database files (if any local SQLite)
*.sqlite
*.db

# Ignore virtual environment
venv/
env/

# Ignore logs and cache
*.log
*.cache

# Ignore model and processed data files
*.pkl
*.joblib
*.csv

# Node.js / React
node_modules/
dist/
build/
.npm/
.cache/
# If using yarn:
yarn.lock
# If using npm:
package-lock.json

# Ignore temporary files
*.tmp
*.swp
